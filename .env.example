# DataForgeTest backend — environment template.
#
# Copy to .env and fill in. .env is git-ignored (.gitignore:30) and MUST NEVER
# be committed. This file contains no real secrets and is safe to track.

# ── Flask ──────────────────────────────────────────────────────────────────
# Setting FLASK_ENV=production turns on fail-closed behaviour: CORS_ALLOWED_ORIGINS
# becomes mandatory and the auth store refuses to fall back to a dev account.
FLASK_ENV=production
FLASK_DEBUG=False

# ── CORS (required in production) ──────────────────────────────────────────
# Exact frontend origin(s), comma-separated. There is no built-in production
# default: if this is unset with FLASK_ENV=production the app refuses to start.
CORS_ALLOWED_ORIGINS=https://data-forge-test.vercel.app

# ── Authentication ─────────────────────────────────────────────────────────
# JSON array of users. Generate a password hash with:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('pw'))"
# Unset in production => empty user store => every login fails (fail closed).
# NOTE: this only guards /api/auth/validate.
#
# PREFER AUTH_USERS_FILE. Docker Compose expands $ in .env values AND in
# env_file entries, and a werkzeug hash looks like "method$salt$digest" — so an
# unescaped hash arrives truncated at its first $, and every correct password is
# then rejected. File contents are never interpolated. (The app now refuses to
# start on a malformed hash rather than failing logins silently.)
AUTH_USERS_FILE=/run/secrets/auth_users.json
#
# If you use the inline variable instead, escape every $ as $$:
# AUTH_USERS=[{"id":"u1","name":"Admin","email":"you@example.com","password_hash":"scrypt:32768:8:1$$salt$$digest","role":"admin"}]

# ── API token (required in production) ─────────────────────────────────────
# Bearer token(s) for the business API, comma-separated so they can be rotated
# without downtime: add the new one, move clients over, then drop the old one.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Every route requires it except /, /api/stats, /api/auth/validate and the
# per-blueprint /health probes. Clients send either header:
#   Authorization: Bearer <token>
#   X-API-Token: <token>
# With FLASK_ENV=production and no API_TOKENS the app refuses to start.
API_TOKENS=

# Explicit, greppable opt-out. Setting this to true serves every business route
# without authentication. Never do this on an internet-facing instance.
# API_AUTH_DISABLED=false

# ── LLM ────────────────────────────────────────────────────────────────────
# Provider: ollama | gemini | anthropic. Defaults to ollama in code.
# IMPORTANT: setting only LLM_MODEL is not enough — most call sites read
# LLM_PROVIDER independently and fall back to "ollama". Set both.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://ollama:11434
# Only for the hosted providers; leave unset when using ollama.
# LLM_API_KEY=
# GEMINI_API_KEY=

# ── Uploads ────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB is the single limit every feature module reads. The hard Flask
# wall (MAX_CONTENT_LENGTH) is derived as MAX_UPLOAD_MB + UPLOAD_OVERHEAD_MB.
# (ACCURACY_MAX_UPLOAD_MB used to be documented here but was never read by any
# code — it is gone. Use MAX_UPLOAD_MB.)
MAX_UPLOAD_MB=10
UPLOAD_OVERHEAD_MB=2

# ── Rate limiting ──────────────────────────────────────────────────────────
# memory:// is per-process: with N gunicorn workers the real limit is N times
# what you configure, and it resets on restart. Use a shared backend for
# anything reachable from the internet.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=200 per day,50 per hour
# Per-category overrides (defaults live in src/limiter.py):
# RATELIMIT_LLM=10 per minute;100 per hour
# RATELIMIT_GENERATE=3 per minute;20 per hour
# RATELIMIT_UPLOAD=10 per minute;60 per hour
# RATELIMIT_HEAVY=20 per minute;200 per hour
# RATELIMIT_ADMIN=5 per hour

# ── Diagnostics ────────────────────────────────────────────────────────────
# /api/rag/debug discloses the LLM provider, which API keys are set, absolute
# paths and indexed document names. Leave false on anything internet-facing.
RAG_DEBUG_ENDPOINT=false

# ── Platform stats ─────────────────────────────────────────────────────────
# tests/ is excluded from the image (.dockerignore), so /api/stats cannot count
# tests at runtime and would report 0. Baseline measured on this branch:
# 399 backend + 487 frontend.
PLATFORM_TESTS_TOTAL=886
# Cap on the storage/ walk performed by /api/stats.
STATS_SCAN_LIMIT=5000

# ── Storage paths ──────────────────────────────────────────────────────────
VECTOR_STORE_PATH=./storage/vectorstore
SYNTH_STORAGE_PATH=./storage/synth
ACCURACY_STORAGE_PATH=./storage/accuracy
GOLD_STORAGE_PATH=./storage/gold

# ── Feature limits ─────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=4
SYNTH_MAX_ROWS=1000000
SYNTH_REQUEST_TIMEOUT=300
SYNTH_MAX_MEM_MB=2048
ACCURACY_MAX_ROWS=2000000
ACCURACY_REQUEST_TIMEOUT=120
METRICS_MAX_ROWS=50000
GOLD_ALLOWED_FILE_TYPES=.csv,.xlsx,.xls,.parquet
GOLD_REQUEST_TIMEOUT=300
MAX_ROWS_WARN=500000
