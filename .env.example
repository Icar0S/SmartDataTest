# DataForgeTest backend — environment template.
#
# Copy to .env and fill in. .env is git-ignored (.gitignore:30) and MUST NEVER
# be committed. This file contains no real secrets and is safe to track.

# ── Flask ──────────────────────────────────────────────────────────────────
# Setting FLASK_ENV=production turns on fail-closed behaviour: CORS_ALLOWED_ORIGINS
# becomes mandatory and the auth store refuses to fall back to a dev account.
FLASK_ENV=production
FLASK_DEBUG=False

# ── CORS (required in production) ──────────────────────────────────────────
# Exact frontend origin(s), comma-separated. There is no built-in production
# default: if this is unset with FLASK_ENV=production the app refuses to start.
# Origem real do frontend: data-forge-test.vercel.app responde 307 para
# smart-data-test.vercel.app, entao e ESTA que o navegador envia em Origin.
CORS_ALLOWED_ORIGINS=https://smart-data-test.vercel.app,https://data-forge-test.vercel.app

# ── Google sign-in ─────────────────────────────────────────────────────────
# All three together turn it on; none of them runs without sign-in; only some of
# them and the app refuses to start. On the server they are written by
# ~/srv/bin/configurar-sso-plataforma.sh, which never echoes them. Full
# instructions in docs/AUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
# Where the browser returns to; must be listed in CORS_ALLOWED_ORIGINS.
FRONTEND_URL=https://smart-data-test.vercel.app
# Exactly as registered in the Google Cloud console.
OIDC_REDIRECT_URI=https://api.smartdatatest.com/api/auth/google/callback
# User database. Not inside storage/, which is served for download.
AUTH_DB_PATH=./auth-data/auth.sqlite3
# Optional, and public: shown to people waiting for approval.
AUTH_CONTACT=

# ── API tokens (scripts) ───────────────────────────────────────────────────
# Bearer token(s) for machines, comma-separated so they can be rotated without
# downtime: add the new one, move clients over, then drop the old one.
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# People do not use these: they sign in with Google. Never put one in a frontend
# build — REACT_APP_* variables end up in the bundle, where anyone reads them.
# May be empty when sign-in is configured. With FLASK_ENV=production and neither,
# the app refuses to start. Clients send either header:
#   Authorization: Bearer <token>
#   X-API-Token: <token>
API_TOKENS=

# Explicit, greppable opt-out. Setting this to true serves every business route
# without authentication. Never do this on an internet-facing instance.
# API_AUTH_DISABLED=false

# ── Admin token (destructive operations) ───────────────────────────────────
# Required by POST /api/rag/ingest, POST /api/rag/reload and
# DELETE /api/rag/sources/<id>.
#
# Separate from API_TOKENS because that one is inlined into the frontend bundle
# and is therefore readable by anyone — it cannot protect an operation that
# deletes data. Cloudflare Access cannot cover these either: it matches on
# path, and GET /api/rag/sources (used by the frontend) shares a path with the
# DELETE. Unset => those routes are unreachable rather than falling back to the
# public token. NEVER expose this to the frontend.
ADMIN_TOKENS=

# ── LLM ────────────────────────────────────────────────────────────────────
# Provider: ollama | smartdatatest | gemini | anthropic. Defaults to ollama in code.
# smartdatatest is the LLM API at https://llm.smartdatatest.com: same models as
# the local Ollama, reachable from any machine. Needs LLM_API_KEY (created at
# https://llm.smartdatatest.com/console); LLM_API_BASE_URL and LLM_API_TIMEOUT
# (seconds, default 300) are optional. It records requests for 7 days.
# IMPORTANT: setting only LLM_MODEL is not enough — most call sites read
# LLM_PROVIDER independently and fall back to "ollama". Set both.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
# Inside a container, localhost is the container. host.docker.internal reaches
# the host's loopback-bound Ollama, so it keeps Metal GPU acceleration while
# staying unreachable from the LAN.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Only for the hosted providers; leave unset when using ollama.
# LLM_API_KEY=
# LLM_API_BASE_URL=https://llm.smartdatatest.com
# GEMINI_API_KEY=

# ── Uploads ────────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB is the single limit every feature module reads. The hard Flask
# wall (MAX_CONTENT_LENGTH) is derived as MAX_UPLOAD_MB + UPLOAD_OVERHEAD_MB.
# (ACCURACY_MAX_UPLOAD_MB used to be documented here but was never read by any
# code — it is gone. Use MAX_UPLOAD_MB.)
MAX_UPLOAD_MB=10
UPLOAD_OVERHEAD_MB=2

# ── Rate limiting ──────────────────────────────────────────────────────────
# memory:// is per-process. That is safe here only because gunicorn runs one
# worker with threads (see the Dockerfile CMD), so the configured limit is the
# real one. Counters still reset on restart. If you ever raise the worker count
# or run more than one replica, move this to redis:// at the same time or the
# limits silently multiply by the number of processes.
RATELIMIT_STORAGE_URI=memory://
# Semicolon-separated. The health probes are exempt from this (see
# src/limiter.py) so the container HEALTHCHECK cannot exhaust it.
RATELIMIT_DEFAULT=200 per day;50 per hour
# Per-category overrides (defaults live in src/limiter.py):
# RATELIMIT_LLM=10 per minute;100 per hour
# RATELIMIT_GENERATE=3 per minute;20 per hour
# RATELIMIT_UPLOAD=10 per minute;60 per hour
# RATELIMIT_HEAVY=20 per minute;200 per hour
# RATELIMIT_ADMIN=5 per hour

# ── Backend URL ────────────────────────────────────────────────────────────
# Used in the Content-Security-Policy connect-src directive.
BACKEND_URL=https://api.smartdatatest.com

# ── Diagnostics ────────────────────────────────────────────────────────────
# /api/rag/debug discloses the LLM provider, which API keys are set, absolute
# paths and indexed document names. Leave false on anything internet-facing.
RAG_DEBUG_ENDPOINT=false

# ── Platform stats ─────────────────────────────────────────────────────────
# tests/ is excluded from the image (.dockerignore), so /api/stats cannot count
# tests at runtime and would report 0. Baseline measured on this branch:
# 399 backend + 487 frontend.
PLATFORM_TESTS_TOTAL=886
# Cap on the storage/ walk performed by /api/stats.
STATS_SCAN_LIMIT=5000

# ── Storage paths ──────────────────────────────────────────────────────────
# Relative paths apply when running on the host. compose.prod.yaml overrides
# them with absolute paths, because the working directory is /app/src and a
# relative path would land outside the mounted volume.
VECTOR_STORE_PATH=./storage/vectorstore
SYNTH_STORAGE_PATH=./storage/synth
ACCURACY_STORAGE_PATH=./storage/accuracy
GOLD_STORAGE_PATH=./storage/gold
METRICS_STORAGE_PATH=./uploads/metrics
CHECKLIST_STORAGE_PATH=./storage/checklist

# ── Feature limits ─────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=4
SYNTH_MAX_ROWS=1000000
SYNTH_REQUEST_TIMEOUT=300
SYNTH_MAX_MEM_MB=2048
ACCURACY_MAX_ROWS=2000000
ACCURACY_REQUEST_TIMEOUT=120
METRICS_MAX_ROWS=50000
GOLD_ALLOWED_FILE_TYPES=.csv,.xlsx,.xls,.parquet
GOLD_REQUEST_TIMEOUT=300
MAX_ROWS_WARN=500000
