# Build-time configuration for the Vercel production build.
#
# REACT_APP_API_TOKEN is deliberately NOT set here: it is a secret and this file
# is committed. Set it in the Vercel project's Environment Variables, where it
# is injected at build time. Without it every business route returns 401.
#
# At cutover this URL becomes https://api.smartdatatest.com — see the parity
# checklist. Left pointing at Render until that decision is made.
REACT_APP_API_URL=https://dataforgetest-backend.onrender.com
