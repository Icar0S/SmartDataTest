# Build-time configuration for the Vercel production build.
#
# Create React App inlines every REACT_APP_* variable into the bundle, where
# anyone can read it. No credential may ever be put in one. (REACT_APP_API_TOKEN
# used to be, and is why that token had to be retired; see docs/AUTH.md.)
#
# REACT_APP_VERSION and REACT_APP_COMMIT are set by the deploy pipeline.
REACT_APP_API_URL=https://api.smartdatatest.com
