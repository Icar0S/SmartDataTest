{
  "name": "smartdatatest-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Testes E2E do SmartDataTest com Playwright que percorrem a plataforma e gravam a apresentação em MP4.",
  "scripts": {
    "setup": "playwright install chromium",
    "apresentacao": "playwright test --grep @apresentacao",
    "pitch": "playwright test --grep @pitch",
    "test": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "@types/node": "^20.17.0",
    "typescript": "5.6.3"
  }
}
